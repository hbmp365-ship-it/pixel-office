{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-office",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE_ROOM",
        "class_name": "OfficeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OfficeRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
